# ── AXION — .htaccess raiz ──────────────────────────────────────
# OWASP A05: Security Misconfiguration

# Forçar HTTPS (após ativar SSL na Locaweb)
RewriteEngine On
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Bloquear acesso direto a arquivos sensíveis
<FilesMatch "\.(env|log|sql|sh|bak|git|htpasswd)$">
    Require all denied
</FilesMatch>

# Bloquear acesso direto a setup.php após usar
<Files "setup.php">
    # Remova o comentário abaixo depois que o setup for concluído:
    # Require all denied
</Files>

# Bloquear listagem de diretórios
Options -Indexes

# Headers de segurança (OWASP A05)
<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    # CSP — ajuste se adicionar CDNs extras
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self'; frame-ancestors 'none'"
</IfModule>

# PHP — nunca exibir erros em produção (OWASP A05)
<IfModule mod_php.c>
    php_flag display_errors off
    php_flag log_errors on
    php_value error_log /tmp/axion_errors.log
</IfModule>

# Proteger arquivos internos do PHP
<FilesMatch "^_">
    Require all denied
</FilesMatch>
